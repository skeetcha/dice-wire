{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "dice-wire-schema.json",
    "title": "Data",
    "description": "Data for the Dice Wire Framework",
    "type": "object",
    "$defs": {
        "attribute": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "description": "The id of the attribute"
                    },
                    "name": {
                        "type": "string",
                        "description": "The name of the attribute"
                    },
                    "description": {
                        "type": "string",
                        "description": "The description of the attribute."
                    },
                    "type": {
                        "type": "string",
                        "enum": [
                            "object",
                            "value"
                        ],
                        "description": "The type of attribute this holds in the data"
                    },
                    "objectName": {
                        "type": "string",
                        "description": "The name of the object (e.g. race, class, etc.)"
                    }
                },
                "required": [
                    "id",
                    "name",
                    "description",
                    "type"
                ],
                "if": {
                    "properties": {
                        "type": {
                            "const": "object"
                        }
                    }
                },
                "then": {
                    "required": [
                        "objectName"
                    ]
                }
            }
        },
        "skill": {
            "type": "object",
            "properties": {
                "proficiency": {
                    "oneOf": [
                        {
                            "type": "array",
                            "description": "The values that proficiency can be, and are referenced by the level-up system",
                            "items": {
                                "type": "number",
                                "minItems": 1
                            }
                        },
                        {
                            "type": "array",
                            "description": "The tiers of proficiency that are referenced by the level-up system",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "description": "The name of this proficiency tier"
                                    },
                                    "formula": {
                                        "type": "string",
                                        "description": "The formula to use for calculating this tier's proficiency value"
                                    }
                                },
                                "required": [
                                    "name",
                                    "formula"
                                ]
                            }
                        }
                    ]
                },
                "skills": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "id": {
                                "type": "string",
                                "description": "The id of the skill"
                            },
                            "name": {
                                "type": "string",
                                "description": "The name of the skill"
                            },
                            "attribute": {
                                "type": "string",
                                "description": "The id of the attribute that this skill uses"
                            },
                            "description": {
                                "type": "string",
                                "description": "A description of the skill"
                            },
                            "canAddLabel": {
                                "type": "boolean",
                                "description": "Can the skill have a label added? (e.g. Pathfinder 2nd edition's Lore skills)",
                                "default": false
                            }
                        },
                        "required": [
                            "id",
                            "name",
                            "attribute",
                            "description"
                        ]
                    }
                }
            },
            "required": [
                "proficiency",
                "skills"
            ]
        },
        "damageType": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "description": "The id of the damage type"
                    },
                    "name": {
                        "type": "string",
                        "description": "The name of the damage type"
                    },
                    "description": {
                        "type": "string",
                        "description": "The description of the damage type"
                    }
                },
                "required": [
                    "id",
                    "name"
                ]
            }
        },
        "ancestry": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "description": "The id of the ancestry"
                    },
                    "name": {
                        "type": "string",
                        "description": "The name of the ancestry"
                    },
                    "features": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "description": "The id of a feature of the ancestry"
                        },
                        "description": "The features of the ancestry"
                    },
                    "hp": {
                        "type": "number",
                        "description": "The amount of HP that a character of this ancestry gets, if any"
                    },
                    "size": {
                        "oneOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                }
                            }
                        ],
                        "description": "The id of the size of a creature of this ancestry. If a player can choose from more than one size for this ancestry, include them here as an array"
                    },
                    "speed": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "id": {
                                    "type": "string",
                                    "description": "The id of the speed type"
                                },
                                "value": {
                                    "type": "number",
                                    "description": "The amount of squares of that speed type this ancestry grants (each square is 5 feet in imperial units or 1 meter in metric units)",
                                    "minimum": 0
                                }
                            }
                        }
                    }
                },
                "required": [
                    "id",
                    "name",
                    "features",
                    "size",
                    "speed"
                ]
            }
        },
        "size": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "description": "The id of the size"
                    },
                    "name": {
                        "type": "string",
                        "description": "The name of the size"
                    },
                    "squares": {
                        "type": "number",
                        "description": "How many squares does a creature of this size take up?"
                    }
                },
                "required": [
                    "id",
                    "name",
                    "squares"
                ]
            }
        },
        "speed": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "description": "The id of the speed type"
                    },
                    "name": {
                        "type": "string",
                        "description": "The name of the speed type"
                    }
                },
                "required": [
                    "id",
                    "name"
                ]
            }
        }
    },
    "properties": {
        "_meta": {
            "description": "Metadata for the included arrays",
            "type": "object",
            "properties": {
                "version": {
                    "type": "string",
                    "description": "The source version, e.g. \"1.2.3\""
                },
                "dateUpdated": {
                    "type": "string",
                    "description": "The date that the source was updated, in the format YYYY-MM-DD (RFC3339).",
                    "format": "date"
                }
            }
        },
        "attribute": {
            "$ref": "#/$defs/attribute"
        },
        "skill": {
            "$ref": "#/$defs/skill"
        },
        "damageType": {
            "$ref": "#/$defs/damageType"
        },
        "ancestry": {
            "$ref": "#/$defs/ancestry"
        },
        "size": {
            "$ref": "#/$defs/size"
        },
        "speed": {
            "$ref": "#/$defs/speed"
        }
    },
    "required": [
        "_meta"
    ]
}